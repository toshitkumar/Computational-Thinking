<script>
  const roles = ["ICT Trainer", "Web Developer", "Game Developer", "Video Editor", "Robotics Educator"];
  let ri = 0, ci = 0, deleting = false;
  const el = document.getElementById('role-text');
  function tick(){
    const full = "&gt; " + roles[ri];
    const plain = roles[ri];
    if(!deleting){
      ci++;
      el.innerHTML = "&gt; " + plain.slice(0, ci);
      if(ci === plain.length){ deleting = true; setTimeout(tick, 1400); return; }
    } else {
      ci--;
      el.innerHTML = "&gt; " + plain.slice(0, ci);
      if(ci === 0){ deleting = false; ri = (ri+1) % roles.length; }
    }
    setTimeout(tick, deleting ? 45 : 90);
  }
  tick();

  // reveal on scroll
  const io = new IntersectionObserver((entries)=>{
    entries.forEach(e=>{
      if(e.isIntersecting){ e.target.style.opacity = 1; e.target.style.transform = 'translateY(0)'; }
    });
  }, {threshold:0.12});
  document.querySelectorAll('.brick, .chip, .rail-item, .about-card, .info-block').forEach(elm=>{
    elm.style.opacity = 0;
    elm.style.transform = 'translateY(18px)';
    elm.style.transition = 'opacity .5s ease, transform .5s ease';
    io.observe(elm);
  });
</script>


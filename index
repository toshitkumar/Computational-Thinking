<style>
:root{
  --bg:#0A1F1C;
  --bg-2:#0E2621;
  --panel:#123028;
  --panel-2:#163a30;
  --trace:#2F6F5A;
  --copper:#D89B5D;
  --copper-dim:#8a6339;
  --cyan:#5EE7D3;
  --amber:#FFB74D;
  --cream:#EDEDE3;
  --muted:#8FA69E;
  --danger:#FF6B5E;
  --radius:10px;
  --mono: 'JetBrains Mono', monospace;
  --sans: 'IBM Plex Sans', sans-serif;
}
*{box-sizing:border-box; margin:0; padding:0;}
html{scroll-behavior:smooth;}
body{
  background:var(--bg);
  color:var(--cream);
  font-family:var(--sans);
  line-height:1.6;
  overflow-x:hidden;
  position:relative;
}

/* ---------- circuit trace background ---------- */
.trace-bg{
  position:fixed; inset:0; z-index:0; pointer-events:none; opacity:0.35;
}
.trace-line{ fill:none; stroke:var(--trace); stroke-width:1.5; }
.trace-dot{ fill:var(--cyan); filter:drop-shadow(0 0 4px var(--cyan)); }
@keyframes flow{
  to{ stroke-dashoffset:-400; }
}
.trace-flow{ stroke-dasharray:6 10; animation:flow 6s linear infinite; }

/* ---------- layout shells ---------- */
.wrap{ max-width:1100px; margin:0 auto; padding:0 24px; position:relative; z-index:2; }
section{ padding:96px 0; position:relative; }

/* ---------- nav ---------- */
nav{
  position:sticky; top:0; z-index:50;
  background:rgba(10,31,28,0.9);
  backdrop-filter:blur(8px);
  border-bottom:1px solid var(--trace);
}
.nav-inner{ max-width:1100px; margin:0 auto; padding:14px 24px; display:flex; align-items:center; justify-content:space-between; }
.logo-mark{ font-family:var(--mono); font-weight:800; color:var(--cream); font-size:15px; letter-spacing:0.5px; display:flex; align-items:center; gap:8px; }
.logo-mark .led{ width:8px; height:8px; border-radius:50%; background:var(--cyan); box-shadow:0 0 8px var(--cyan); animation:blink 2.4s ease-in-out infinite; }
@keyframes blink{ 0%,100%{opacity:1;} 50%{opacity:0.25;} }
.nav-links{ display:flex; gap:6px; list-style:none; font-family:var(--mono); font-size:12px; }
.nav-links a{
  color:var(--muted); text-decoration:none; padding:8px 12px; border-radius:6px;
  border:1px solid transparent; transition:all .2s;
}
.nav-links a:hover{ color:var(--cream); border-color:var(--trace); background:var(--panel); }
.nav-cta{
  font-family:var(--mono); font-size:12px; color:var(--bg); background:var(--copper);
  padding:9px 16px; border-radius:6px; text-decoration:none; font-weight:700;
  box-shadow:0 3px 0 var(--copper-dim);
}
.nav-cta:hover{ transform:translateY(1px); box-shadow:0 2px 0 var(--copper-dim); }
@media(max-width:720px){ .nav-links{display:none;} }

/* ---------- hero ---------- */
.hero{ padding-top:70px; padding-bottom:60px; }
.hero-tag{
  font-family:var(--mono); font-size:12px; color:var(--cyan); letter-spacing:2px;
  display:inline-flex; align-items:center; gap:8px; text-transform:uppercase;
  border:1px solid var(--trace); padding:6px 12px; border-radius:20px; background:var(--panel);
}
.hero-tag .dot{ width:7px; height:7px; border-radius:50%; background:var(--cyan); box-shadow:0 0 6px var(--cyan); animation:blink 2s infinite; }
.hero h1{
  font-family:var(--mono); font-weight:800; font-size:clamp(34px,6vw,64px);
  margin:22px 0 8px; color:var(--cream); letter-spacing:-1px; line-height:1.05;
}
.hero h1 span{ color:var(--copper); }
.role-line{
  font-family:var(--mono); font-size:clamp(15px,2.4vw,20px); color:var(--muted); margin-bottom:22px; height:28px;
}
.role-line .cursor{ display:inline-block; width:9px; background:var(--cyan); height:18px; vertical-align:middle; margin-left:2px; animation:blink 1s steps(2) infinite; }
.hero p.desc{ max-width:640px; color:var(--muted); font-size:16px; margin-bottom:28px; }
.hero-actions{ display:flex; gap:14px; flex-wrap:wrap; }
.btn{
  font-family:var(--mono); font-weight:700; font-size:13px; text-decoration:none;
  padding:13px 22px; border-radius:8px; display:inline-flex; align-items:center; gap:8px;
  transition:all .15s ease;
}
.btn-primary{ background:var(--copper); color:var(--bg); box-shadow:0 4px 0 var(--copper-dim); }
.btn-primary:hover{ transform:translateY(2px); box-shadow:0 2px 0 var(--copper-dim); }
.btn-ghost{ border:1px solid var(--trace); color:var(--cream); background:var(--panel); }
.btn-ghost:hover{ border-color:var(--cyan); color:var(--cyan); }

.stat-strip{ display:grid; grid-template-columns:repeat(4,1fr); gap:14px; margin-top:52px; }
.stat-chip{
  background:var(--panel); border:1px solid var(--trace); border-radius:8px;
  padding:16px 14px; text-align:center; position:relative;
}
.stat-chip::before, .stat-chip::after{
  content:''; position:absolute; width:10px; height:3px; background:var(--copper-dim); top:50%; transform:translateY(-50%);
}
.stat-chip::before{ left:-10px; } .stat-chip::after{ right:-10px; }
.stat-chip .num{ font-family:var(--mono); font-weight:800; font-size:24px; color:var(--cyan); }
.stat-chip .lbl{ font-family:var(--mono); font-size:10px; color:var(--muted); text-transform:uppercase; letter-spacing:1px; margin-top:4px; }
@media(max-width:640px){ .stat-strip{ grid-template-columns:repeat(2,1fr); } }

/* ---------- section headers ---------- */
.sec-head{ margin-bottom:44px; }
.sec-eyebrow{ font-family:var(--mono); font-size:12px; color:var(--copper); text-transform:uppercase; letter-spacing:2px; }
.sec-title{ font-family:var(--mono); font-size:clamp(24px,4vw,36px); font-weight:800; color:var(--cream); margin-top:8px; }

/* ---------- about ---------- */
.about-grid{ display:grid; grid-template-columns:1.3fr 1fr; gap:40px; align-items:start; }
.about-card{
  background:var(--panel); border:1px solid var(--trace); border-radius:var(--radius); padding:28px;
}
.about-card p{ color:var(--cream); font-size:15.5px; margin-bottom:14px; }
.about-card p:last-child{ margin-bottom:0; }
.about-card .accent{ color:var(--cyan); font-weight:600; }
.info-block{ background:var(--panel-2); border:1px solid var(--trace); border-radius:var(--radius); padding:22px; }
.info-row{ display:flex; justify-content:space-between; padding:10px 0; border-bottom:1px dashed var(--trace); font-family:var(--mono); font-size:13px; }
.info-row:last-child{ border-bottom:none; }
.info-row .k{ color:var(--muted); }
.info-row .v{ color:var(--cream); text-align:right; }
@media(max-width:800px){ .about-grid{ grid-template-columns:1fr; } }

/* ---------- skills as bricks ---------- */
.brick-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:22px; }
.brick{
  background:var(--panel); border:1px solid var(--trace); border-radius:8px;
  padding:22px 18px 18px; position:relative; transition:transform .18s ease, box-shadow .18s ease, border-color .18s ease;
  box-shadow:0 6px 0 rgba(0,0,0,0.35);
}
.brick:hover{ transform:translateY(-6px); border-color:var(--cyan); box-shadow:0 12px 18px rgba(0,0,0,0.4); }
.studs{ position:absolute; top:-9px; left:18px; display:flex; gap:14px; }
.stud{ width:16px; height:16px; border-radius:50%; background:var(--panel-2); border:1px solid var(--trace); }
.brick:hover .stud{ border-color:var(--cyan); }
.brick .brick-icon{ font-family:var(--mono); font-size:12px; color:var(--copper); letter-spacing:1px; text-transform:uppercase; margin-bottom:10px; }
.brick h3{ font-family:var(--mono); font-size:16px; color:var(--cream); margin-bottom:10px; }
.brick .tags{ display:flex; flex-wrap:wrap; gap:6px; }
.brick .tags span{
  font-family:var(--mono); font-size:11px; color:var(--muted); background:var(--bg-2);
  border:1px solid var(--trace); padding:4px 8px; border-radius:4px;
}
@media(max-width:860px){ .brick-grid{ grid-template-columns:repeat(2,1fr); } }
@media(max-width:560px){ .brick-grid{ grid-template-columns:1fr; } }

/* ---------- experience as breadboard rail ---------- */
.rail{ position:relative; padding-left:38px; }
.rail::before{
  content:''; position:absolute; left:9px; top:6px; bottom:6px; width:2px;
  background:repeating-linear-gradient(var(--trace), var(--trace) 6px, transparent 6px, transparent 12px);
}
.rail-item{ position:relative; margin-bottom:40px; }
.rail-item:last-child{ margin-bottom:0; }
.rail-node{
  position:absolute; left:-38px; top:2px; width:20px; height:20px; border-radius:50%;
  background:var(--bg-2); border:2px solid var(--cyan); box-shadow:0 0 10px rgba(94,231,211,0.5);
}
.rail-node::after{ content:''; position:absolute; inset:5px; border-radius:50%; background:var(--cyan); }
.rail-card{ background:var(--panel); border:1px solid var(--trace); border-radius:8px; padding:20px 22px; }
.rail-top{ display:flex; justify-content:space-between; align-items:baseline; flex-wrap:wrap; gap:8px; margin-bottom:6px; }
.rail-role{ font-family:var(--mono); font-weight:700; color:var(--cream); font-size:16px; }
.rail-date{ font-family:var(--mono); font-size:12px; color:var(--amber); }
.rail-org{ font-size:13.5px; color:var(--muted); margin-bottom:14px; }
.rail-card ul{ padding-left:18px; color:var(--cream); font-size:14.5px; }
.rail-card ul li{ margin-bottom:6px; }

/* ---------- projects as IC chips ---------- */
.chip-grid{ display:grid; grid-template-columns:repeat(2,1fr); gap:22px; }
.chip{
  background:var(--panel); border:1px solid var(--trace); border-radius:6px; padding:24px;
  position:relative; transition:border-color .2s, transform .2s;
}
.chip:hover{ border-color:var(--copper); transform:translateY(-3px); }
.pin-row{ position:absolute; top:14px; bottom:14px; width:8px; }
.pin-row.left{ left:-8px; } .pin-row.right{ right:-8px; }
.pin-row span{ display:block; width:8px; height:6px; background:var(--copper-dim); margin-bottom:8px; border-radius:1px; }
.chip .chip-cat{ font-family:var(--mono); font-size:11px; color:var(--cyan); text-transform:uppercase; letter-spacing:1px; }
.chip h3{ font-family:var(--mono); font-size:17px; margin:8px 0 10px; color:var(--cream); }
.chip p{ font-size:14px; color:var(--muted); margin-bottom:14px; }
.chip .tags{ display:flex; flex-wrap:wrap; gap:6px; }
.chip .tags span{ font-family:var(--mono); font-size:10.5px; color:var(--copper); border:1px solid var(--copper-dim); padding:3px 8px; border-radius:4px; }
@media(max-width:720px){ .chip-grid{ grid-template-columns:1fr; } .pin-row{ display:none; } }

/* ---------- contact as terminal ---------- */
.terminal{
  background:#081613; border:1px solid var(--trace); border-radius:10px; overflow:hidden;
  box-shadow:0 20px 60px rgba(0,0,0,0.4);
}
.term-bar{ background:var(--panel-2); padding:10px 16px; display:flex; align-items:center; gap:8px; }
.term-dot{ width:11px; height:11px; border-radius:50%; }
.term-bar .t-r{ background:#ff5f56; } .term-bar .t-y{ background:#ffbd2e; } .term-bar .t-g{ background:#27c93f; }
.term-title{ font-family:var(--mono); font-size:11px; color:var(--muted); margin-left:8px; }
.term-body{ padding:28px 26px; font-family:var(--mono); font-size:14px; color:var(--cyan); }
.term-body .prompt{ color:var(--copper); }
.term-body .out{ color:var(--cream); }
.term-body a{ color:var(--cyan); text-decoration:underline; }
.term-line{ margin-bottom:10px; }
.blink-cursor{ display:inline-block; width:8px; height:16px; background:var(--cyan); vertical-align:middle; animation:blink 1s steps(2) infinite; margin-left:4px;}
.contact-actions{ display:flex; gap:14px; margin-top:26px; flex-wrap:wrap; }

footer{ text-align:center; padding:34px 0; font-family:var(--mono); font-size:12px; color:var(--muted); border-top:1px solid var(--trace); }
footer .led{ color:var(--cyan); }

::selection{ background:var(--copper); color:var(--bg); }
</style>
</head>
